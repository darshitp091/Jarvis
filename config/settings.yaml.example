# JARVIS settings -- copy to `config/settings.yaml` and edit.
#
# NO CREDENTIALS BELONG IN THIS FILE. Every `api_key`, `client_id`,
# `client_secret` and `api_secret` below is left blank on purpose and each one
# names the `.env` variable that actually feeds it. `.env` is git-ignored;
# settings.yaml is not tracked either, but it is the file that once carried a
# live token into git history, so keys are read environment-first: a variable
# set in `.env` wins over anything written here. See `.env.example` for the
# full list.
#
# Everything else in this file -- model ids, thresholds, feature toggles -- is
# ordinary configuration and belongs here.

jarvis:
  name: JARVIS
  wake_word: hey jarvis
  wake_word_mode: auto
  user_name: Sir
  pin_enabled: false  # set true after first run

models:
  main_brain: qwen2.5-coder:7b
  vision: moondream:latest
  code: qwen2.5-coder:7b
  medical: qwen2.5-coder:7b
  safety: qwen2.5-coder:7b
  filler: qwen2.5-coder:7b
  embeddings: nomic-embed-text:latest
  science: qwen2.5-coder:7b

audio:
  sample_rate: 16000
  silence_threshold: 2.2     # seconds of silence to stop listening
  wake_word_sensitivity: 0.5
  engine: local              # Options: groq, local, sarvam

tts:
  engine: edge                    # Options: fish (Fish Audio S2.1 Pro), edge (Microsoft)
  default_voice: hinglish         # Options: english, hinglish (Edge backend only)
  fish_audio:
    # Fish Audio S2.1 Pro via OpenRouter: far more expressive/human than Edge.
    # Key: OPENROUTER_API_KEY in .env. With no key at all, JARVIS silently
    # stays on Edge TTS.
    model: "fish-audio/s2.1-pro-free:free"
    api_key: ""
    timeout: 30
    use_for_fillers: false
    http_referer: ""
    app_title: "JARVIS"
  voices:
    english:
      ref_speaker: en-IN-NeerjaNeural
    hinglish:
      ref_speaker: hi-IN-SwaraNeural
  speaking_rate: 1.30
  speaking_pitch: -12
  dsp:
    reverb_room_size: 0.15
    reverb_wet_level: 0.05
    reverb_dry_level: 0.95

ui:
  orb_size_idle: 80
  orb_size_listening: 120
  position: top_center
  always_on_top: true

memory:
  db_path: ./jarvis_brain/lancedb
  max_memories: 10000
  retrieve_top_k: 5
  memory_ttl_days: 90

# ---------------------------------------------------------------------------
# Local-first services. These require no third-party API keys.
# ---------------------------------------------------------------------------
scheduler:
  enabled: true
  # How often the scheduler wakes to look for due jobs, in seconds.
  poll_interval: 20
  # A job that came due while JARVIS was closed still fires on the next start,
  # as long as it is no more than this many minutes late.
  misfire_grace_minutes: 120

calendar:
  enabled: true
  # IANA timezone name, e.g. Asia/Kolkata, Europe/London, America/New_York.
  timezone: Asia/Kolkata
  # Spoken each morning if a daily briefing reminder is scheduled.
  briefing_time: "08:00"
  # Optional folder watched for .ics files to import. Leave blank to disable.
  ics_import_dir: ""

# ---------------------------------------------------------------------------
# Optional third-party providers. Leave keys blank to run fully offline;
# JARVIS falls back to local Ollama models when these are absent.
# ---------------------------------------------------------------------------
spotify:
  # Keys: SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET in .env.
  client_id: ""
  client_secret: ""
  redirect_uri: "http://127.0.0.1:8888/callback"
  api_enabled: false

# Speech-to-text only. Whisper on Groq is what `audio.engine: groq` transcribes
# with; no reply, skill or domain answer is generated here. `model` is read by
# nothing and kept only so an older settings.yaml stays loadable.
groq:
  # Key: GROQ_API_KEY in .env.
  api_key: ""
  model: "llama-3.3-70b-versatile"

sarvam:
  # Key: SARVAM_API_KEY in .env.
  api_key: ""
  enabled: false
  language: "hi-IN"
  tts_speaker: "kavya"

obsidian:
  vault_path: "C:\\Users\\<YourUser>\\Documents\\Obsidian Vault"
  daily_notes_folder: "Daily Notes"

# Primary LLM provider: NaraRouter (router.bynara.id), OpenAI-compatible.
# One key serves both text and vision. Key: BYNARA_API_KEY in .env.
bynara:
  enabled: true
  api_key: ""
  base_url: "https://router.bynara.id/v1"
  # Every reply, skill and domain answer after STT comes from this model.
  # ox-alpha-bynara: the free-tier id that answers at conversational speed and
  # also reads images. mistral-large works but is ~25s/turn, too slow for voice.
  text_model: "ox-alpha-bynara"
  # Screen vision. Sent whenever a call carries images; must be a Vision model.
  vision_model: "ox-alpha-bynara"
  # Set false to keep text remote but never send a screenshot off this machine.
  vision_enabled: true

# Secondary LLM provider, reached only when bynara does not answer. Also
# OpenAI-compatible, so the same code path serves it; it differs only in naming
# a model per role instead of one id. `brain` is the text model and `vision` the
# vision model as far as the cascade is concerned. Key: MISTRAL_API_KEY in .env.
mistral:
  api_key: ""
  models:
    brain: "mistral-large-2512"
    code: "devstral-2512"
    vision: "ministral-8b-2512"
    reasoning: "magistral-medium-2509"
    summary: "open-mistral-nemo"

# Read-only market data. JARVIS never places orders.
groww:
  # Keys: GROWW_API_KEY and GROWW_API_SECRET in .env.
  api_key: ""
  api_secret: ""
