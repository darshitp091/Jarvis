jarvis:
  name: JARVIS
  wake_word: hey jarvis
  wake_word_mode: auto
  user_name: Sir
  pin_enabled: false  # set true after first run

models:
  main_brain: qwen2.5-coder:7b
  vision: moondream:latest
  code: qwen2.5-coder:7b
  medical: qwen2.5-coder:7b
  safety: qwen2.5-coder:7b
  filler: qwen2.5-coder:7b
  embeddings: nomic-embed-text:latest
  science: qwen2.5-coder:7b

audio:
  sample_rate: 16000
  silence_threshold: 2.2     # seconds of silence to stop listening
  wake_word_sensitivity: 0.5
  engine: local              # Options: groq, local, sarvam

tts:
  engine: edge                    # Edge TTS (online)
  default_voice: hinglish         # Options: english, hinglish
  voices:
    english:
      ref_speaker: en-IN-NeerjaNeural
    hinglish:
      ref_speaker: hi-IN-SwaraNeural
  speaking_rate: 1.30
  speaking_pitch: -12
  dsp:
    reverb_room_size: 0.15
    reverb_wet_level: 0.05
    reverb_dry_level: 0.95

ui:
  orb_size_idle: 80
  orb_size_listening: 120
  position: top_center
  always_on_top: true

memory:
  db_path: ./jarvis_brain/lancedb
  max_memories: 10000
  retrieve_top_k: 5
  memory_ttl_days: 90

# ---------------------------------------------------------------------------
# Local-first services. These require no third-party API keys.
# ---------------------------------------------------------------------------
scheduler:
  enabled: true
  # How often the scheduler wakes to look for due jobs, in seconds.
  poll_interval: 20
  # A job that came due while JARVIS was closed still fires on the next start,
  # as long as it is no more than this many minutes late.
  misfire_grace_minutes: 120

calendar:
  enabled: true
  # IANA timezone name, e.g. Asia/Kolkata, Europe/London, America/New_York.
  timezone: Asia/Kolkata
  # Spoken each morning if a daily briefing reminder is scheduled.
  briefing_time: "08:00"
  # Optional folder watched for .ics files to import. Leave blank to disable.
  ics_import_dir: ""

# ---------------------------------------------------------------------------
# Optional third-party providers. Leave keys blank to run fully offline;
# JARVIS falls back to local Ollama models when these are absent.
# ---------------------------------------------------------------------------
spotify:
  client_id: ""
  client_secret: ""
  redirect_uri: "http://127.0.0.1:8888/callback"
  api_enabled: false

groq:
  api_key: ""
  model: "llama-3.3-70b-versatile"

sarvam:
  api_key: ""
  enabled: false
  language: "hi-IN"
  tts_speaker: "kavya"

obsidian:
  vault_path: "C:\\Users\\<YourUser>\\Documents\\Obsidian Vault"
  daily_notes_folder: "Daily Notes"

mistral:
  api_key: ""
  models:
    brain: "mistral-large-2512"
    code: "devstral-2512"
    vision: "ministral-8b-2512"
    reasoning: "magistral-medium-2509"
    summary: "open-mistral-nemo"

ofoxai:
  api_key: ""
  model: "z-ai/glm-4.7-flash:free"

# Read-only market data. JARVIS never places orders.
groww:
  api_key: ""
  api_secret: ""

cloudflare:
  enabled: false
  account_id: ""
  api_token: ""
  model: "@cf/meta/llama-3.1-8b-instruct"
