# JARVIS environment secrets -- copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is git-ignored; this template is committed. Loaded at boot by
# jarvis.core.env_loader before any provider reads a key. This file is where
# credentials belong: every value here wins over the matching field in
# config/settings.yaml, which is read only as a courtesy to configs written
# before the keys moved -- and which is the file that once carried a live token
# into git history. A variable already exported in your shell wins over the
# value in the file.

# --- Bynara (NaraRouter) : primary LLM provider, text and vision -------------
# One key for router.bynara.id -- OpenAI-compatible chat + vision. This is the
# main brain and the screen-vision model. Get it from your NaraRouter account.
BYNARA_API_KEY=

# --- Groq : speech-to-text only ---------------------------------------------
# Groq Cloud Whisper transcribes your voice (audio_engine). It is NOT an LLM
# provider here. Leave blank to fall back to local Whisper.
GROQ_API_KEY=

# --- Mistral : secondary LLM provider ---------------------------------------
# Used when Bynara is unreachable, before the local Ollama fallback.
MISTRAL_API_KEY=

# --- Fish Audio / OpenRouter : premium TTS voice (optional) -----------------
OPENROUTER_API_KEY=

# --- Sarvam : Hinglish TTS (optional) ---------------------------------------
SARVAM_API_KEY=

# --- Spotify : music playback via the Web API (optional) --------------------
# From developer.spotify.com -> your app. Without these, playback falls back to
# the desktop-GUI path, which needs no credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Groww : live Indian market data (optional) -----------------------------
GROWW_API_KEY=
GROWW_API_SECRET=

# --- Email : reading and sending mail (optional) ----------------------------
JARVIS_SMTP_SERVER=smtp.gmail.com
JARVIS_SMTP_PORT=587
JARVIS_IMAP_SERVER=imap.gmail.com
JARVIS_EMAIL_USER=
JARVIS_EMAIL_PASS=
