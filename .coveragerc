[run]
# KNOWN LIMITATION -- read before trusting the TOTAL.
#
# `source = .` auto-discovers never-imported files only inside importable
# packages. services/ has an __init__.py, so all of its modules are reported.
# core/, skills/, and ui/ do NOT, so a file there appears only if a test
# actually imports it. 15 of the repo's 87 modules are currently measured:
# 4 of core/'s 20, all 5 under services/, and 6 top-level scripts. All 33
# skills/ and 9 ui/ modules are absent from the denominator entirely.
#
# core/intent_router.py is the worked example of the mechanism: it was absent
# until tests/test_intent_router.py imported it, and its arrival added all 992
# of its statements to the denominator at once. The TOTAL rose anyway because
# the same tests covered more than 992/6690 of them -- but a test that imports
# a large module and exercises little of it will DROP the total. Check the
# per-file column, not just the gate, when adding a first test for a module.
#
# The TOTAL therefore means "percentage of discovered code exercised", not
# "percentage of the repository tested", and it is dominated by main.py
# (3386 of 5698 statements, 0% covered). The gate is still a valid regression
# detector over a stable denominator -- but the denominator grows whenever a
# new module gets imported by a test, so re-measure after adding tests instead
# of assuming the previous number still holds.
#
# Phase 3 moves everything into real packages under src/jarvis/, at which point
# all modules become discoverable and the gate must be re-measured from scratch.
source = .
omit =
    # Virtualenvs, vendored code, and local scratch work are not this project.
    jarvis_env/*
    venv/*
    env/*
    ENV/*
    node_modules/*
    scratch/*
    bin/*
    models/*
    # The tests are near-100% covered by construction; counting them would
    # inflate the total and make the gate meaningless as a measure of how much
    # shipped code is exercised.
    tests/*
    conftest.py
    setup.py

[report]
# A partially-imported module still reports its executed lines, so missing
# ranges are the useful signal when raising the gate.
show_missing = True
skip_covered = False
