# Python environment
jarvis_env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
ENV/

# Large Model Weights (Downloaded separately)
# GitHub rejects any file over 100 MB. The fine-tuned Whisper checkpoint is
# ~922 MB, so weights are never committed; see the README for how to obtain
# or re-finetune them locally.
*.onnx
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
!voices.json

# Caches and logs
# `.cache*`, not `.cache`: the bare form matches that exact filename only, which
# is why .cache-jarvis-spotify -- a live Spotify OAuth token cache -- sat tracked
# in the public remote from 31daa7d (2026-07-30) onward.
.cache*
.pytest_cache/
# Coverage artifacts. `.coverage` is a SQLite database of line hits, rewritten
# on every run; `.cache*` does not match it. Rules live here rather than in
# .coveragerc, which controls what is measured, not what git tracks.
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log
error.log
error2.log
pip_list.log
test_jarvis_brain_numpy/
voices.json

# Operating System Files
.DS_Store
Thumbs.db

# User data and dynamic settings
config/kpis.db
config/chart.png
jarvis_brain/
notes.txt
*.db
*.sqlite
# SQLite WAL sidecars. Regenerated on every run; committing them corrupts a
# clone that opens the db with a different journal state.
*.db-shm
*.db-wal
# Scraped page caches and personal contact data, both machine-local.
config/site_cache_*
config/contacts_cache.json

# IDEs
.vscode/
.idea/

# Large binaries, local configs, and scratch files
bin/
scratch/
src/jarvis/auth/.adb_wireless_config
config/voice_profile.json
# Contains real API keys. Never commit; use config/settings.yaml.example as the
# template. Git treats a trailing comment on a path line as part of the filename,
# so the comment must live on its own line for this rule to actually match.
config/settings.yaml
config/settings.yaml.bak

# Local user directories and media
models/
obsidian_vault/
*.mp3
node_modules

# Build artifacts
# `pip install -e .` writes src/jarvis_assistant.egg-info/ on every run. Until
# pyproject.toml existed the tree was not installable, so nothing generated
# these and no rule was needed; now `git add -A` would commit one.
*.egg-info/
build/
dist/
